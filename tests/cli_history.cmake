cmake_minimum_required(VERSION 3.21)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(work "${BUILD_DIR}/cli-history-${suffix}")
file(MAKE_DIRECTORY "${work}")
set(db "${work}/library.sqlite")

function(run)
    execute_process(COMMAND "${CLI}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err ENCODING UTF8)
    if(NOT status STREQUAL "0" OR NOT err STREQUAL "")
        message(FATAL_ERROR "Unexpected status or diagnostic while exercising history: ${status} ${err}")
    endif()
    set(result "${out}" PARENT_SCOPE)
endfunction()

run(--db "${db}" "${DEMO_DIR}/backup-register.docx" "Тритон")
set(original "${result}")
run(--db "${db}" "Тритон")
if(NOT result STREQUAL "Ответ из кэша.\n${original}")
    message(FATAL_ERROR "Second invocation must show a cache hit with the same DOCX citation")
endif()
run(--db "${db}" "${DEMO_DIR}/contract.txt" "Астрономия")
run(--history "${db}")
if(NOT result MATCHES "mock-extractive-v1 [|] ревизия 1 [(]устарела[)]" OR
   NOT result MATCHES "Ответ из кэша" OR NOT result MATCHES "таблица 1, строка 2, ячейка 2" OR
   NOT result MATCHES "Астрономия\nВ библиотеке не найдено")
    message(FATAL_ERROR "History must include the earlier citations, revision, model, hit and no-match result")
endif()
run(--source "${db}" 2 1)
if(NOT result MATCHES "таблица 1, строка 2, ячейка 2" OR NOT result MATCHES "Копия: .*\\.docx")
    message(FATAL_ERROR "The cached DOCX citation must resolve in a new process: ${result}")
endif()
run(--clear-history "${db}")
run(--history "${db}")
if(NOT result STREQUAL "История пуста.\n")
    message(FATAL_ERROR "Clearing history must survive a separate invocation")
endif()
file(REMOVE_RECURSE "${work}")
