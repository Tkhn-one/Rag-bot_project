string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef id)
set(db "${BUILD_DIR}/local-cli-${id}.sqlite")
set(question "Резервное копирование")

function(check_cli expected pattern calls)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status
                    OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT "${status}" STREQUAL "${expected}" OR NOT "${output}${error}" MATCHES "${pattern}"
       OR NOT error MATCHES "http_calls=${calls} key_reads=${calls}")
        message(FATAL_ERROR "CLI exit ${status}\n${output}${error}")
    endif()
endfunction()

if(CASE STREQUAL "files")
    set(bad "${BUILD_DIR}/bad-${id}.gguf")
    set(unc "//localhost/rag-offline-test")
    check_cli(1 "базу на локальном диске" 0 --history "${unc}/db.sqlite")
    check_cli(1 "базу на локальном диске" 0 --db "${unc}/db.sqlite" --local-model "${bad}" "${question}")
    check_cli(1 "локального импорта" 0 --db "${db}" --local-model "${bad}" "${unc}/file.txt" "${question}")
    if(GENERATOR)
        set(missing "GGUF генератора недоступен")
        set(mismatch "Размер или SHA-256")
        check_cli(1 "${missing}" 0 --db "${db}" --local-model "${unc}/model.gguf" "${question}")
    else()
        set(missing "Локальная генерация отключена")
        set(mismatch "${missing}")
    endif()
    check_cli(1 "${missing}" 0 --db "${db}" --local-model "${bad}" "${question}")
    file(WRITE "${bad}" "GGUF truncated")
    check_cli(1 "${mismatch}" 0 --db "${db}" --local-model "${bad}" "${question}")
    file(REMOVE "${bad}")
    check_cli(0 "История пуста" 0 --history "${db}")
    check_cli(0 "decisions.txt" 0 --db "${db}" "${DEMO_DIR}/decisions.txt" "${question}")
    # Positive control: the same executable must count its remote adapter.
    check_cli(0 "AllowRemote" 0 --policy "${db}" library allow-remote)
    check_cli(0 "AllowRemote" 0 --policy "${db}" document 1 allow-remote)
    check_cli(1 "соединение с OpenAI" 1 --db "${db}" --openai "${question}")
else()
    set(local --db "${db}" --embedding-model "${EMBEDDINGS}" --local-model "${MODEL}")
    check_cli(0 "decisions.txt, строка 4" 0 ${local} "${DEMO_DIR}/contract.txt" "${DEMO_DIR}/decisions.txt" "${question}")
    check_cli(0 "LocalOnly" 0 --documents "${db}")
    check_cli(0 "Ответ из кэша" 0 ${local} "${question}")
    check_cli(0 "Qwen3-4B-Q4_K_M" 0 --history "${db}")
endif()
file(REMOVE "${db}")
